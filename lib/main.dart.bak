// ============================================================
// EMERGENCY DIALOG
// ============================================================

void showEmergencyDialog(
    BuildContext context,
    ) {
  showDialog(
    context: context,

    builder: (context) {
      return AlertDialog(
        shape:
        RoundedRectangleBorder(
          borderRadius:
          BorderRadius.circular(
            22,
          ),
        ),

        title: const Row(
          children: [
            Icon(
              Icons.warning_rounded,

              color:
              Color(0xFFE92335),
            ),

            SizedBox(
              width: 8,
            ),

            Text(
              'Emergency Call',
            ),
          ],
        ),

        content: const Text(
          'Do you want to call emergency services now?\n\n'
              'Emergency number: 123',
        ),

        actions: [
          TextButton(
            onPressed: () {
              Navigator.pop(
                context,
              );
            },

            child: const Text(
              'Cancel',

              style: TextStyle(
                color:
                Colors.grey,
              ),
            ),
          ),

          ElevatedButton(
            style:
            ElevatedButton.styleFrom(
              backgroundColor:
              const Color(
                0xFFE92335,
              ),

              foregroundColor:
              Colors.white,
            ),

            onPressed: () async {
              Navigator.pop(
                context,
              );

              final Uri phoneUri =
              Uri(
                scheme: 'tel',
                path: '123',
              );

              try {
                final launched =
                await launchUrl(
                  phoneUri,
                );

                if (!launched &&
                    context.mounted) {
                  ScaffoldMessenger
                      .of(context)
                      .showSnackBar(
                    const SnackBar(
                      content: Text(
                        'Calling is not available on this emulator.',
                      ),
                    ),
                  );
                }
              } catch (_) {
                if (context.mounted) {
                  ScaffoldMessenger
                      .of(context)
                      .showSnackBar(
                    const SnackBar(
                      content: Text(
                        'Calling is not available on this emulator.',
                      ),
                    ),
                  );
                }
              }
            },

            child:
            const Text(
              'Call 123',
            ),
          ),
        ],
      );
    },
  );
}

