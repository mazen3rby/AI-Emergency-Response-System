                              MaterialPageRoute(
                                  builder: (_) => const MapScreen()),
                            ),
                            icon: const Icon(
                              Icons.navigation_rounded,
                              color: brandRed,
                              size: 20,
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

