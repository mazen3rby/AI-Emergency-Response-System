// MAP MARKER
// ============================================================

class MapHelperMarker
    extends StatelessWidget {
  final IconData icon;

  const MapHelperMarker({
    super.key,

    required this.icon,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 35,
      height: 35,

      decoration:
      BoxDecoration(
        color:
        Colors.white,

        shape:
        BoxShape.circle,

        border:
        Border.all(
          color:
          const Color(
            0xFFFFB5BC,
          ),

          width: 2,
        ),

        boxShadow: [
          BoxShadow(
            color:
            Colors.black.withOpacity(
              0.10,
            ),

            blurRadius: 4,
          ),
        ],
      ),

      child: Icon(
        icon,

        color:
        const Color(
          0xFFE92335,
        ),

        size: 17,
      ),
    );
  }
}

// ============================================================
// MAP PAINTER
// ============================================================

class MapPainter
    extends CustomPainter {
  @override
  void paint(
      Canvas canvas,
      Size size,
      ) {
    final background =
    Paint()
      ..color =
      const Color(
        0xFFE9F0EC,
      );

    canvas.drawRect(
      Offset.zero & size,
      background,
    );

    // River

    final riverPaint =
    Paint()
      ..color =
      const Color(
        0xFFB8DDEB,
      )

      ..strokeWidth = 22

      ..style =
          PaintingStyle.stroke;

    final river =
    Path();

    river.moveTo(
      -10,
      size.height * 0.75,
    );

    river.cubicTo(
      size.width * 0.25,
      size.height * 0.48,

      size.width * 0.52,
      size.height * 0.95,

      size.width + 10,
      size.height * 0.23,
    );

    canvas.drawPath(
      river,
      riverPaint,
    );

    // Main road

    final roadPaint =
    Paint()
      ..color =
          Colors.white

      ..strokeWidth = 9

      ..style =
          PaintingStyle.stroke;

    final road1 =
    Path();

    road1.moveTo(
      -10,
      size.height * 0.18,
    );

    road1.lineTo(
      size.width + 10,
      size.height * 0.78,
    );

    canvas.drawPath(
      road1,
      roadPaint,
    );

    // Second road

    final road2 =
    Path();

    road2.moveTo(
      size.width * 0.05,
      size.height + 10,
    );

    road2.lineTo(
      size.width * 0.86,
      -10,
    );

    canvas.drawPath(
      road2,
      roadPaint,
    );

    // Small roads

    final smallRoadPaint =
    Paint()
      ..color =
      const Color(
        0xFFD7DDD8,
      )

      ..strokeWidth = 2

      ..style =
          PaintingStyle.stroke;

    for (int i = 0; i < 6; i++) {
      final path =
      Path();

      path.moveTo(
        size.width * (i / 6),
        0,
      );

      path.lineTo(
        size.width *
            ((i + 1) / 7),

        size.height,
      );

      canvas.drawPath(
        path,
        smallRoadPaint,
      );
    }
  }

  @override
  bool shouldRepaint(
      covariant CustomPainter oldDelegate,
      ) {
    return false;
  }
}
